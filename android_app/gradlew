##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell such as ksh or
#       bash, to run this script, type that shell name before the whole command
#       line like:
#
#           ksh Gradle
#
#       Busybox and similar reduced functionality shells are not supported.
#
#   (2) You need to have a Java JDK installed. The Java executable should be
#       in your path. This script will try to find a Java executable in
#       the following order:
#
#       (a) JAVA_HOME environment variable
#       (b) PATH
#
#
#   (3) If you want to specify the JDK version for Gradle to use, you can
#       do so by setting the JAVA_HOME environment variable to the JDK
#       installation directory.
#
#
#   (4) This script will try to start Gradle with the Java executable
#       specified in JAVA_HOME, if set. If JAVA_HOME is not set, it will
#       try to find a Java executable in the PATH. If no Java executable
#       can be found, it will try to start the Java executable in the current
#       directory. If that fails, it will try to start the Java executable
#       in the JAVA_HOME/bin directory. If that fails, it will print an error
#       message and exit.
#
#
#   Note: This script is designed to work with Java JDK 8 and later.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"} ;
    [ -h "$app_path" ] ; do
  app_path=$APP_HOME/$(readlink "$app_path")
done

# This is normally unused
# shellcheck disable=SC2034
app_base_name=${0##*/}
app_home=$(cd "$APP_HOME" > /dev/null && pwd -P)/

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$(uname -s)" in
  CYGWIN* )
    cygwin=true
    ;;
  Darwin* )
    darwin=true
    ;;
  MSYS* | MINGW* )
    msys=true
    ;;
  NonStop* )
    nonstop=true
    ;;
esac

CLASSPATH=$app_home/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/bin/java" ] ; then
        JAVACMD=$JAVA_HOME/bin/java
    else
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        MAX_FD=$(ulimit -H -n) ||
            warn "Could not query maximum file descriptor limit"
      ;;
    esac
    case $MAX_FD in
      '' | soft) :;; # Leave empty or "soft" as-is
      *)              
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
      ;;
    esac
fi

# Collect all arguments for the java command, following the shell quoting and substitution rules
# We will use the variable "args" to collect all the arguments for the java command
# and then pass them to the java command using eval

eval set -- $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "\"-Dorg.gradle.appname=$app_base_name\"" -classpath "\"$CLASSPATH\"" org.gradle.wrapper.GradleWrapperMain "$@"

# Use eval to pass the arguments to the java command
# This handles all the arguments correctly, including those with spaces
# The quotes around the arguments are preserved
# The arguments are passed as-is to the java command

exec "$JAVACMD" "$@"
